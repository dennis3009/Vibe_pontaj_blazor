<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">VibePontaj</a>
        <AuthorizeView>
            <Authorized>
                <span class="text-white small">@context.User.Identity?.Name</span>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView Context="authContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="timesheet">
                        <span class="bi bi-clock-fill-nav-menu" aria-hidden="true"></span> Timesheet
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="attendance">
                        <span class="bi bi-calendar-check-fill-nav-menu" aria-hidden="true"></span> Attendance
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="leave">
                        <span class="bi bi-calendar-x-fill-nav-menu" aria-hidden="true"></span> Leave Requests
                    </NavLink>
                </div>

                @if (authContext.User.IsInRole("Manager") || authContext.User.IsInRole("Admin"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="approvals">
                            <span class="bi bi-check-circle-fill-nav-menu" aria-hidden="true"></span> Approvals
                        </NavLink>
                    </div>
                }

                @if (authContext.User.IsInRole("Admin"))
                {
                    <div class="nav-item px-3">
                        <hr class="my-2" />
                        <small class="text-muted ps-3">Administration</small>
                    </div>
                    
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/employees">
                            <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Employees
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/projects">
                            <span class="bi bi-briefcase-fill-nav-menu" aria-hidden="true"></span> Projects
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/contracts">
                            <span class="bi bi-file-earmark-text-fill-nav-menu" aria-hidden="true"></span> Contracts
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/allocations">
                            <span class="bi bi-diagram-3-fill-nav-menu" aria-hidden="true"></span> Allocations
                        </NavLink>
                    </div>
                }

                <div class="nav-item px-3">
                    <hr class="my-2" />
                    <NavLink class="nav-link" href="logout">
                        <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Logout
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

