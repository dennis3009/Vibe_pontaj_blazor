@page "/admin/employees"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject IEmployeeRepository EmployeeRepository
@inject IAuthService AuthService
@inject IExcelExportService ExcelExportService
@inject IJSRuntime JSRuntime

<PageTitle>Manage Employees - VibePontaj</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>
                <span class="bi bi-people-fill me-2"></span>
                Manage Employees
            </h2>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="@(() => successMessage = null)"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading employees...</p>
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-12">
                <button class="btn btn-primary" @onclick="ShowAddModal">
                    <span class="bi bi-plus-lg me-2"></span>Add New Employee
                </button>
                <button class="btn btn-success ms-2" @onclick="ExportToExcel">
                    <span class="bi bi-file-earmark-excel-fill me-2"></span>Export to Excel
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Hire Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (employees == null || !employees.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted">No employees found</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var employee in employees)
                                {
                                    <tr>
                                        <td>@employee.Id</td>
                                        <td>@employee.FullName</td>
                                        <td>@employee.Email</td>
                                        <td>
                                            <span class="badge bg-@GetRoleBadgeColor(employee.Role)">@employee.Role</span>
                                        </td>
                                        <td>@employee.HireDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge bg-@(employee.IsActive ? "success" : "secondary")">
                                                @(employee.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-warning" @onclick="() => ShowEditModal(employee)">
                                                <span class="bi bi-pencil-fill"></span>
                                            </button>
                                            @if (employee.IsActive)
                                            {
                                                <button class="btn btn-sm btn-danger ms-1" @onclick="() => DeactivateEmployee(employee)">
                                                    <span class="bi bi-x-circle-fill"></span>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@* Add/Edit Modal *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(isEditMode ? "Edit Employee" : "Add New Employee")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="currentEmployee.FirstName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="currentEmployee.LastName" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" @bind="currentEmployee.Email" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Role <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="currentEmployee.Role">
                                <option value="Employee">Employee</option>
                                <option value="Manager">Manager</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Hire Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" @bind="currentEmployee.HireDate" />
                        </div>
                        @if (!isEditMode)
                        {
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Password <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" @bind="newPassword" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6 mb-3">
                                <label class="form-label">New Password (leave blank to keep current)</label>
                                <input type="password" class="form-control" @bind="newPassword" />
                            </div>
                        }
                    </div>
                    @if (isEditMode)
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="currentEmployee.IsActive" id="isActive" />
                                    <label class="form-check-label" for="isActive">
                                        Active
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveEmployee">
                        <span class="bi bi-save me-2"></span>Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Employee> employees = new();
    private Employee currentEmployee = new();
    private string newPassword = string.Empty;
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditMode = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        try
        {
            isLoading = true;
            var result = await EmployeeRepository.GetAllAsync();
            employees = result.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading employees: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddModal()
    {
        currentEmployee = new Employee
        {
            HireDate = DateTime.Today,
            IsActive = true,
            Role = "Employee"
        };
        newPassword = string.Empty;
        isEditMode = false;
        showModal = true;
        errorMessage = null;
    }

    private void ShowEditModal(Employee employee)
    {
        currentEmployee = new Employee
        {
            Id = employee.Id,
            FirstName = employee.FirstName,
            LastName = employee.LastName,
            Email = employee.Email,
            Role = employee.Role,
            HireDate = employee.HireDate,
            IsActive = employee.IsActive,
            PasswordHash = employee.PasswordHash
        };
        newPassword = string.Empty;
        isEditMode = true;
        showModal = true;
        errorMessage = null;
    }

    private void CloseModal()
    {
        showModal = false;
        currentEmployee = new();
        newPassword = string.Empty;
    }

    private async Task SaveEmployee()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(currentEmployee.FirstName) ||
                string.IsNullOrWhiteSpace(currentEmployee.LastName) ||
                string.IsNullOrWhiteSpace(currentEmployee.Email))
            {
                errorMessage = "Please fill in all required fields.";
                return;
            }

            if (!isEditMode && string.IsNullOrWhiteSpace(newPassword))
            {
                errorMessage = "Password is required for new employees.";
                return;
            }

            if (isEditMode)
            {
                if (!string.IsNullOrWhiteSpace(newPassword))
                {
                    currentEmployee.PasswordHash = AuthService.HashPassword(newPassword);
                }
                currentEmployee.UpdatedAt = DateTime.UtcNow;
                await EmployeeRepository.UpdateAsync(currentEmployee);
                successMessage = "Employee updated successfully.";
            }
            else
            {
                currentEmployee.PasswordHash = AuthService.HashPassword(newPassword);
                currentEmployee.CreatedAt = DateTime.UtcNow;
                await EmployeeRepository.CreateAsync(currentEmployee);
                successMessage = "Employee created successfully.";
            }

            CloseModal();
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving employee: {ex.Message}";
        }
    }

    private async Task DeactivateEmployee(Employee employee)
    {
        try
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
                $"Are you sure you want to deactivate {employee.FullName}?");
            
            if (confirmed)
            {
                await EmployeeRepository.DeleteAsync(employee.Id);
                successMessage = $"Employee {employee.FullName} deactivated successfully.";
                await LoadEmployees();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deactivating employee: {ex.Message}";
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            var data = ExcelExportService.ExportEmployees(employees);
            var fileName = $"Employees_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(data));
            successMessage = "Employees exported successfully.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error exporting to Excel: {ex.Message}";
        }
    }

    private string GetRoleBadgeColor(string role)
    {
        return role switch
        {
            "Admin" => "danger",
            "Manager" => "warning",
            "Employee" => "info",
            _ => "secondary"
        };
    }
}
