@page "/approvals"
@attribute [Authorize(Roles = "Manager,Admin")]
@inject ITimesheetRepository TimesheetRepository
@inject IEmployeeRepository EmployeeRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Approvals Dashboard - VibePontaj</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>
                <span class="bi bi-clipboard-check-fill me-2"></span>
                Approvals Dashboard
            </h2>
            <p class="text-muted">Manage timesheet and leave approvals in one place</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="@(() => successMessage = null)"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading approvals...</p>
        </div>
    }
    else
    {
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "timesheets" ? "active" : "")" 
                        @onclick="@(() => SetActiveTab("timesheets"))" 
                        type="button">
                    <span class="bi bi-clock-fill me-2"></span>
                    Timesheet Approvals (@pendingTimesheetGroups.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "leaves" ? "active" : "")" 
                        @onclick="@(() => NavigateToLeaveApprovals())" 
                        type="button">
                    <span class="bi bi-calendar-x-fill me-2"></span>
                    Leave Approvals
                </button>
            </li>
        </ul>

        @if (activeTab == "timesheets")
        {
            @if (pendingTimesheetGroups.Any())
            {
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="alert alert-info">
                            <span class="bi bi-info-circle-fill me-2"></span>
                            <strong>@pendingTimesheetGroups.Count</strong> pending timesheet(s) from <strong>@pendingTimesheetGroups.Select(g => g.EmployeeId).Distinct().Count()</strong> employee(s)
                        </div>
                    </div>
                </div>

                @foreach (var group in pendingTimesheetGroups.OrderBy(g => GetEmployeeName(g.EmployeeId)).ThenBy(g => g.WeekStart))
                {
                    <div class="card mb-3 @GetCardBorderClass(group.Status)">
                        <div class="card-header @GetCardHeaderClass(group.Status)">
                            <div class="row align-items-center">
                                <div class="col-md-4">
                                    <h5 class="mb-0">
                                        <span class="bi bi-person-fill me-2"></span>
                                        @GetEmployeeName(group.EmployeeId)
                                    </h5>
                                </div>
                                <div class="col-md-4 text-center">
                                    <strong>Week @group.WeekNumber, @group.Year</strong>
                                    <br />
                                    <small>@group.WeekStart.ToString("MMM dd") - @group.WeekEnd.ToString("MMM dd, yyyy")</small>
                                </div>
                                <div class="col-md-4 text-end">
                                    <span class="badge @GetStatusBadgeClass(group.Status) me-2">
                                        <span class="@GetStatusIcon(group.Status) me-1"></span>
                                        @group.Status
                                    </span>
                                    <strong class="fs-5">@group.TotalHours.ToString("0.0") hrs</strong>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (expandedGroupId == GetGroupId(group))
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 15%;">Date</th>
                                                <th style="width: 10%;">Day</th>
                                                <th style="width: 25%;">Project</th>
                                                <th style="width: 10%;">Hours</th>
                                                <th style="width: 40%;">Description</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var entry in group.Entries.OrderBy(e => e.Date))
                                            {
                                                var isWeekend = entry.Date.DayOfWeek == DayOfWeek.Saturday || entry.Date.DayOfWeek == DayOfWeek.Sunday;
                                                <tr class="@(isWeekend ? "table-secondary" : "")">
                                                    <td class="fw-bold">@entry.Date.ToString("MMM dd, yyyy")</td>
                                                    <td>@entry.Date.ToString("ddd")</td>
                                                    <td>
                                                        <span class="badge bg-info text-dark">
                                                            @(GetProjectName(entry))
                                                        </span>
                                                    </td>
                                                    <td class="fw-bold">@entry.Hours</td>
                                                    <td>@entry.Description</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <th colspan="3" class="text-end">Total:</th>
                                                <th class="text-primary">@group.TotalHours.ToString("0.0") hrs</th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="@(() => CollapseGroup())">
                                    <span class="bi bi-chevron-up me-1"></span> Hide Details
                                </button>
                                
                                @if (processingGroupId == GetGroupId(group))
                                {
                                    @if (showRejectForm)
                                    {
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Rejection Reason <span class="text-danger">*</span></label>
                                            <textarea class="form-control" rows="3" 
                                                      @bind="rejectionReason" 
                                                      placeholder="Please provide a detailed reason for rejection"></textarea>
                                        </div>
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-danger" @onclick="@(() => ConfirmReject(group))" disabled="@isProcessing">
                                                @if (isProcessing)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                                }
                                                <span class="bi bi-x-circle-fill me-2"></span>
                                                Confirm Rejection
                                            </button>
                                            <button class="btn btn-secondary" @onclick="CancelAction" disabled="@isProcessing">
                                                Cancel
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning mb-3">
                                            <span class="bi bi-exclamation-triangle-fill me-2"></span>
                                            Are you sure you want to approve this timesheet? This will lock the week and the employee won't be able to edit it.
                                        </div>
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-success" @onclick="@(() => ConfirmApprove(group))" disabled="@isProcessing">
                                                @if (isProcessing)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                                }
                                                <span class="bi bi-check-circle-fill me-2"></span>
                                                Confirm Approval
                                            </button>
                                            <button class="btn btn-secondary" @onclick="CancelAction" disabled="@isProcessing">
                                                Cancel
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-success" @onclick="@(() => StartApprove(group))">
                                            <span class="bi bi-check-circle-fill me-2"></span>Approve Timesheet
                                        </button>
                                        <button class="btn btn-danger" @onclick="@(() => StartReject(group))">
                                            <span class="bi bi-x-circle-fill me-2"></span>Reject Timesheet
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-md-8">
                                        <p class="mb-0">
                                            <strong>@group.Entries.Count</strong> timesheet entries spanning <strong>@group.Entries.Select(e => e.Date.Date).Distinct().Count()</strong> days
                                        </p>
                                        <small class="text-muted">Submitted on @group.Entries.First().UpdatedAt?.ToString("MMM dd, yyyy HH:mm")</small>
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="@(() => ExpandGroup(GetGroupId(group)))">
                                            <span class="bi bi-eye-fill me-1"></span> View Details
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <span class="bi bi-info-circle-fill me-2"></span>
                    <strong>No pending timesheet approvals.</strong> All timesheets have been processed.
                </div>
            }
        }
    }
</div>

@code {
    private class TimesheetGroup
    {
        public int EmployeeId { get; set; }
        public int Year { get; set; }
        public int WeekNumber { get; set; }
        public DateTime WeekStart { get; set; }
        public DateTime WeekEnd { get; set; }
        public List<VibePontaj.Models.Timesheet> Entries { get; set; } = new();
        public decimal TotalHours { get; set; }
        public string Status { get; set; } = "Submitted";
    }

    private int currentManagerId;
    private List<TimesheetGroup> pendingTimesheetGroups = new();
    private Dictionary<int, string> employeeNames = new();
    private bool isLoading = true;
    private bool isProcessing = false;
    private string? errorMessage;
    private string? successMessage;
    private string activeTab = "timesheets";
    private string processingGroupId = string.Empty;
    private string expandedGroupId = string.Empty;
    private bool showRejectForm = false;
    private string rejectionReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var email = user.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value;
                if (!string.IsNullOrEmpty(email))
                {
                    var employee = await EmployeeRepository.GetByEmailAsync(email);
                    if (employee != null)
                    {
                        currentManagerId = employee.Id;
                        await LoadEmployeeNames();
                        await LoadPendingTimesheets();
                    }
                    else
                    {
                        errorMessage = "Employee not found. Please contact administrator.";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading approvals: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadEmployeeNames()
    {
        try
        {
            var employees = await EmployeeRepository.GetAllAsync();
            employeeNames = employees.ToDictionary(e => e.Id, e => e.FullName);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading employee names: {ex.Message}";
        }
    }

    private async Task LoadPendingTimesheets()
    {
        try
        {
            var pendingTimesheets = await TimesheetRepository.GetPendingApprovalsAsync();
            
            // Group by employee and week
            pendingTimesheetGroups = pendingTimesheets
                .GroupBy(t => new { t.EmployeeId, t.Year, t.WeekNumber })
                .Select(g => new TimesheetGroup
                {
                    EmployeeId = g.Key.EmployeeId,
                    Year = g.Key.Year,
                    WeekNumber = g.Key.WeekNumber,
                    WeekStart = GetWeekStartDate(g.Key.Year, g.Key.WeekNumber),
                    WeekEnd = GetWeekEndDate(g.Key.Year, g.Key.WeekNumber),
                    Entries = g.ToList(),
                    TotalHours = g.Sum(t => t.Hours),
                    Status = "Submitted"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading pending timesheets: {ex.Message}";
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        errorMessage = null;
        successMessage = null;
    }

    private void NavigateToLeaveApprovals()
    {
        NavigationManager.NavigateTo("/leave/approve");
    }

    private void ExpandGroup(string groupId)
    {
        expandedGroupId = groupId;
    }

    private void CollapseGroup()
    {
        expandedGroupId = string.Empty;
    }

    private void StartApprove(TimesheetGroup group)
    {
        processingGroupId = GetGroupId(group);
        showRejectForm = false;
        if (expandedGroupId != GetGroupId(group))
        {
            expandedGroupId = GetGroupId(group);
        }
    }

    private void StartReject(TimesheetGroup group)
    {
        processingGroupId = GetGroupId(group);
        showRejectForm = true;
        rejectionReason = string.Empty;
        if (expandedGroupId != GetGroupId(group))
        {
            expandedGroupId = GetGroupId(group);
        }
    }

    private void CancelAction()
    {
        processingGroupId = string.Empty;
        showRejectForm = false;
        rejectionReason = string.Empty;
    }

    private async Task ConfirmApprove(TimesheetGroup group)
    {
        try
        {
            isProcessing = true;
            errorMessage = null;

            // Update all entries in the group to Approved status
            foreach (var entry in group.Entries)
            {
                entry.Status = "Approved";
                entry.ApprovedBy = currentManagerId;
                entry.ApprovedAt = DateTime.UtcNow;
                entry.UpdatedAt = DateTime.UtcNow;
                await TimesheetRepository.UpdateAsync(entry);
            }

            // Lock the week
            await TimesheetRepository.LockWeekAsync(group.EmployeeId, group.Year, group.WeekNumber);

            successMessage = $"Timesheet approved successfully for {GetEmployeeName(group.EmployeeId)} - Week {group.WeekNumber}, {group.Year}. The week has been locked.";
            CancelAction();
            await LoadPendingTimesheets();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error approving timesheet: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ConfirmReject(TimesheetGroup group)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(rejectionReason))
            {
                errorMessage = "Please provide a reason for rejection.";
                return;
            }

            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
                $"Are you sure you want to reject this timesheet? The employee will be able to edit and resubmit.");

            if (!confirmed)
            {
                return;
            }

            isProcessing = true;
            errorMessage = null;

            // Update all entries in the group to Rejected status
            foreach (var entry in group.Entries)
            {
                entry.Status = "Rejected";
                entry.ApprovedBy = currentManagerId;
                entry.ApprovedAt = DateTime.UtcNow;
                entry.UpdatedAt = DateTime.UtcNow;
                // Note: Timesheet model doesn't have RejectionReason field
                // Consider adding this field to the database schema in the future
                await TimesheetRepository.UpdateAsync(entry);
            }

            // Unlock the week so employee can edit
            await TimesheetRepository.UnlockWeekAsync(group.EmployeeId, group.Year, group.WeekNumber);

            successMessage = $"Timesheet rejected for {GetEmployeeName(group.EmployeeId)} - Week {group.WeekNumber}, {group.Year}. The week has been unlocked for editing.";
            CancelAction();
            await LoadPendingTimesheets();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error rejecting timesheet: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string GetGroupId(TimesheetGroup group)
    {
        return $"{group.EmployeeId}_{group.Year}_{group.WeekNumber}";
    }

    private string GetEmployeeName(int employeeId)
    {
        return employeeNames.TryGetValue(employeeId, out var name) ? name : "Unknown Employee";
    }

    private string GetProjectName(VibePontaj.Models.Timesheet entry)
    {
        // Try to get from dynamic property if available
        var dynamicEntry = entry as dynamic;
        try
        {
            return dynamicEntry.ProjectName ?? "Unknown Project";
        }
        catch
        {
            return "Unknown Project";
        }
    }

    private DateTime GetWeekStartDate(int year, int weekNumber)
    {
        var jan1 = new DateTime(year, 1, 1);
        var daysOffset = DayOfWeek.Monday - jan1.DayOfWeek;
        var firstMonday = jan1.AddDays(daysOffset);
        return firstMonday.AddDays((weekNumber - 1) * 7);
    }

    private DateTime GetWeekEndDate(int year, int weekNumber)
    {
        return GetWeekStartDate(year, weekNumber).AddDays(6);
    }

    private string GetCardBorderClass(string status)
    {
        return status switch
        {
            "Submitted" => "border-warning",
            "Approved" => "border-success",
            "Rejected" => "border-danger",
            _ => "border-secondary"
        };
    }

    private string GetCardHeaderClass(string status)
    {
        return status switch
        {
            "Submitted" => "bg-warning text-dark",
            "Approved" => "bg-success text-white",
            "Rejected" => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Draft" => "bg-secondary",
            "Submitted" => "bg-warning text-dark",
            "Approved" => "bg-success",
            "Rejected" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetStatusIcon(string status)
    {
        return status switch
        {
            "Draft" => "bi-pencil-square",
            "Submitted" => "bi-hourglass-split",
            "Approved" => "bi-check-circle-fill",
            "Rejected" => "bi-x-circle-fill",
            _ => "bi-info-circle"
        };
    }
}
