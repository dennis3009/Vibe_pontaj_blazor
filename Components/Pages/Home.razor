@page "/"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Home - VibePontaj</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container mt-4">
            <h1 class="mb-4">Welcome to VibePontaj</h1>
            
            <div class="row">
                <div class="col-md-12">
                    <div class="alert alert-info">
                        <h4 class="alert-heading">Hello, @context.User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.GivenName)?.Value!</h4>
                        <p>Welcome to the Vibe Pontaj Employee Management System.</p>
                        <hr>
                        <p class="mb-0">
                            Role: <strong>@context.User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</strong>
                        </p>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <span class="bi bi-clock-fill me-2"></span>
                                Timesheet
                            </h5>
                            <p class="card-text">Log your daily project hours and submit for approval.</p>
                            <a href="/timesheet" class="btn btn-primary">Go to Timesheet</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <span class="bi bi-calendar-check-fill me-2"></span>
                                Attendance
                            </h5>
                            <p class="card-text">View and manage your monthly attendance records.</p>
                            <a href="/attendance" class="btn btn-primary">Go to Attendance</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <span class="bi bi-calendar-x-fill me-2"></span>
                                Leave Requests
                            </h5>
                            <p class="card-text">Request and track your leave applications.</p>
                            <a href="/leave" class="btn btn-primary">Go to Leave</a>
                        </div>
                    </div>
                </div>
            </div>

            @if (context.User.IsInRole("Manager") || context.User.IsInRole("Admin"))
            {
                <div class="row mt-3">
                    <div class="col-md-12">
                        <h3>Management</h3>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card border-warning">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <span class="bi bi-check-circle-fill me-2"></span>
                                    Approvals
                                </h5>
                                <p class="card-text">Review and approve timesheet and leave requests.</p>
                                <a href="/approvals" class="btn btn-warning">Go to Approvals</a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (context.User.IsInRole("Admin"))
            {
                <div class="row mt-3">
                    <div class="col-md-12">
                        <h3>Administration</h3>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card border-success">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <span class="bi bi-people-fill me-2"></span>
                                    Employees
                                </h5>
                                <p class="card-text">Manage employee records.</p>
                                <a href="/admin/employees" class="btn btn-success">Manage</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card border-success">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <span class="bi bi-briefcase-fill me-2"></span>
                                    Projects
                                </h5>
                                <p class="card-text">Manage company projects.</p>
                                <a href="/admin/projects" class="btn btn-success">Manage</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card border-success">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <span class="bi bi-file-earmark-text-fill me-2"></span>
                                    Contracts
                                </h5>
                                <p class="card-text">Manage employee contracts.</p>
                                <a href="/admin/contracts" class="btn btn-success">Manage</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card border-success">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <span class="bi bi-diagram-3-fill me-2"></span>
                                    Allocations
                                </h5>
                                <p class="card-text">Manage resource allocations.</p>
                                <a href="/admin/allocations" class="btn btn-success">Manage</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>
