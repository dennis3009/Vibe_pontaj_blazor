@page "/leave"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ILeaveRepository LeaveRepository
@inject ILeaveService LeaveService
@inject IEmployeeRepository EmployeeRepository
@inject IExcelExportService ExcelExportService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Leave Requests - VibePontaj</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>
                <span class="bi bi-calendar-x-fill me-2"></span>
                My Leave Requests
            </h2>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="@(() => successMessage = null)"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading leave requests...</p>
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-12">
                <button class="btn btn-primary" @onclick="ToggleNewRequestForm">
                    <span class="bi bi-plus-lg me-2"></span>@(showNewRequestForm ? "Cancel" : "New Leave Request")
                </button>
                <button class="btn btn-info text-white ms-2" @onclick="ExportToExcel">
                    <span class="bi bi-file-earmark-excel-fill me-2"></span>Export to Excel
                </button>
            </div>
        </div>

        @if (showNewRequestForm)
        {
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <span class="bi bi-file-earmark-plus me-2"></span>
                        New Leave Request
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="leaveType" class="form-label">Leave Type <span class="text-danger">*</span></label>
                            <select id="leaveType" class="form-select" @bind="newLeaveRequest.LeaveType">
                                <option value="">Select Leave Type</option>
                                <option value="Paid">Paid Leave</option>
                                <option value="Sick">Sick Leave</option>
                                <option value="Unpaid">Unpaid Leave</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="startDate" class="form-label">Start Date <span class="text-danger">*</span></label>
                            <input type="date" id="startDate" class="form-control" 
                                   @bind="newLeaveRequest.StartDate" 
                                   @bind:event="oninput"
                                   @onchange="CalculateTotalDays"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="endDate" class="form-label">End Date <span class="text-danger">*</span></label>
                            <input type="date" id="endDate" class="form-control" 
                                   @bind="newLeaveRequest.EndDate"
                                   @bind:event="oninput"
                                   @onchange="CalculateTotalDays"
                                   min="@GetMinEndDate()" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="reason" class="form-label">Reason <span class="text-danger">*</span></label>
                            <textarea id="reason" class="form-control" rows="3" 
                                      @bind="newLeaveRequest.Reason" 
                                      placeholder="Please provide a reason for your leave request"></textarea>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Total Days</label>
                            <div class="alert alert-info mb-0">
                                <h4 class="mb-0">@calculatedTotalDays days</h4>
                                <small class="text-muted">Excluding weekends</small>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <button class="btn btn-success" @onclick="SubmitLeaveRequest" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Submitting...</span>
                                }
                                else
                                {
                                    <span class="bi bi-send-fill me-2"></span>
                                    <span>Submit Request</span>
                                }
                            </button>
                            <button class="btn btn-secondary ms-2" @onclick="CancelNewRequest" disabled="@isSubmitting">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (leaveRequests.Any())
        {
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Leave History</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 10%;">Type</th>
                                    <th style="width: 15%;">Start Date</th>
                                    <th style="width: 15%;">End Date</th>
                                    <th style="width: 10%;">Days</th>
                                    <th style="width: 30%;">Reason</th>
                                    <th style="width: 12%;">Status</th>
                                    <th style="width: 8%;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var leave in leaveRequests.OrderByDescending(l => l.CreatedAt))
                                {
                                    <tr>
                                        <td>
                                            <span class="badge @GetLeaveTypeBadgeClass(leave.LeaveType)">
                                                @leave.LeaveType
                                            </span>
                                        </td>
                                        <td>@leave.StartDate.ToString("MMM dd, yyyy")</td>
                                        <td>@leave.EndDate.ToString("MMM dd, yyyy")</td>
                                        <td class="fw-bold">@leave.TotalDays</td>
                                        <td>
                                            <small>@leave.Reason</small>
                                            @if (!string.IsNullOrEmpty(leave.RejectionReason))
                                            {
                                                <div class="text-danger mt-1">
                                                    <small><strong>Rejection:</strong> @leave.RejectionReason</small>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(leave.Status)">
                                                <span class="@GetStatusIcon(leave.Status) me-1"></span>
                                                @leave.Status
                                            </span>
                                            @if (leave.ApprovedAt.HasValue)
                                            {
                                                <br />
                                                <small class="text-muted">@leave.ApprovedAt.Value.ToString("MMM dd, yyyy")</small>
                                            }
                                        </td>
                                        <td>
                                            @if (leave.Status == "Pending")
                                            {
                                                <button class="btn btn-danger btn-sm" 
                                                        @onclick="@(() => CancelLeaveRequest(leave.Id))"
                                                        title="Cancel Request">
                                                    <span class="bi bi-trash-fill"></span>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <span class="bi bi-info-circle-fill me-2"></span>
                <strong>No leave requests found.</strong> Click "New Leave Request" to submit your first request.
            </div>
        }

        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card border-info">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0">
                            <span class="bi bi-info-circle-fill me-2"></span>
                            Leave Request Guidelines
                        </h6>
                    </div>
                    <div class="card-body">
                        <ul class="mb-0">
                            <li><strong>Paid Leave:</strong> Regular annual leave or vacation days</li>
                            <li><strong>Sick Leave:</strong> Medical leave with or without documentation</li>
                            <li><strong>Unpaid Leave:</strong> Leave without pay for personal reasons</li>
                            <li>Leave requests must be submitted in advance when possible</li>
                            <li>Once approved, leave will automatically update your attendance records</li>
                            <li>Timesheet entries will be blocked for approved leave days</li>
                            <li>You can cancel pending requests, but approved/rejected requests cannot be modified</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int currentEmployeeId;
    private List<Leave> leaveRequests = new();
    private Leave newLeaveRequest = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showNewRequestForm = false;
    private string? errorMessage;
    private string? successMessage;
    private int calculatedTotalDays = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var email = user.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value;
                if (!string.IsNullOrEmpty(email))
                {
                    var employee = await EmployeeRepository.GetByEmailAsync(email);
                    if (employee != null)
                    {
                        currentEmployeeId = employee.Id;
                        await LoadLeaveRequests();
                        InitializeNewRequest();
                    }
                    else
                    {
                        errorMessage = "Employee not found. Please contact administrator.";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading leave requests: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLeaveRequests()
    {
        try
        {
            var leaves = await LeaveRepository.GetByEmployeeIdAsync(currentEmployeeId);
            leaveRequests = leaves.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading leave requests: {ex.Message}";
        }
    }

    private void InitializeNewRequest()
    {
        newLeaveRequest = new Leave
        {
            EmployeeId = currentEmployeeId,
            StartDate = DateTime.Today,
            EndDate = DateTime.Today,
            LeaveType = "",
            Reason = "",
            Status = "Pending"
        };
        calculatedTotalDays = 1;
    }

    private void ToggleNewRequestForm()
    {
        showNewRequestForm = !showNewRequestForm;
        if (showNewRequestForm)
        {
            InitializeNewRequest();
            errorMessage = null;
            successMessage = null;
        }
    }

    private void CancelNewRequest()
    {
        showNewRequestForm = false;
        InitializeNewRequest();
        errorMessage = null;
    }

    private void CalculateTotalDays()
    {
        if (newLeaveRequest.EndDate >= newLeaveRequest.StartDate)
        {
            calculatedTotalDays = CalculateWorkingDays(newLeaveRequest.StartDate, newLeaveRequest.EndDate);
        }
        else
        {
            calculatedTotalDays = 0;
        }
    }

    private int CalculateWorkingDays(DateTime startDate, DateTime endDate)
    {
        int workingDays = 0;
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            if (date.DayOfWeek != DayOfWeek.Saturday && date.DayOfWeek != DayOfWeek.Sunday)
            {
                workingDays++;
            }
        }
        return workingDays;
    }

    private string GetMinEndDate()
    {
        return newLeaveRequest.StartDate.ToString("yyyy-MM-dd");
    }

    private async Task SubmitLeaveRequest()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            if (string.IsNullOrWhiteSpace(newLeaveRequest.LeaveType))
            {
                errorMessage = "Please select a leave type.";
                return;
            }

            if (newLeaveRequest.EndDate < newLeaveRequest.StartDate)
            {
                errorMessage = "End date must be greater than or equal to start date.";
                return;
            }

            if (string.IsNullOrWhiteSpace(newLeaveRequest.Reason))
            {
                errorMessage = "Please provide a reason for your leave request.";
                return;
            }

            if (newLeaveRequest.StartDate < DateTime.Today)
            {
                var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
                    "You are requesting leave for past dates. Are you sure you want to continue?");
                if (!confirmed)
                {
                    return;
                }
            }

            isSubmitting = true;

            await LeaveService.CreateLeaveRequestAsync(newLeaveRequest);

            successMessage = "Leave request submitted successfully! Your manager will review it shortly.";
            showNewRequestForm = false;
            InitializeNewRequest();
            await LoadLeaveRequests();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error submitting leave request: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CancelLeaveRequest(int leaveId)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
                "Are you sure you want to cancel this leave request?");

            if (confirmed)
            {
                await LeaveRepository.DeleteAsync(leaveId);
                successMessage = "Leave request cancelled successfully.";
                await LoadLeaveRequests();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cancelling leave request: {ex.Message}";
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            var leavesWithDetails = await LeaveRepository.GetByEmployeeIdAsync(currentEmployeeId);
            var excelData = ExcelExportService.ExportLeaves(leavesWithDetails);
            var fileName = $"LeaveRequests_{DateTime.Now:yyyyMMdd}.xlsx";

            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(excelData));
            successMessage = "Excel file exported successfully.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error exporting to Excel: {ex.Message}";
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Approved" => "bg-success",
            "Rejected" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetStatusIcon(string status)
    {
        return status switch
        {
            "Pending" => "bi-hourglass-split",
            "Approved" => "bi-check-circle-fill",
            "Rejected" => "bi-x-circle-fill",
            _ => "bi-question-circle"
        };
    }

    private string GetLeaveTypeBadgeClass(string leaveType)
    {
        return leaveType switch
        {
            "Paid" => "bg-primary",
            "Sick" => "bg-info",
            "Unpaid" => "bg-secondary",
            _ => "bg-light text-dark"
        };
    }
}
